 
# ============================================================
# SupplyAI — Variables de Entorno
# INSTRUCCIONES: Copia este archivo a ".env" y llena los valores
#   cp .env.example .env
#
# ⚠️  NUNCA subas el archivo .env al repositorio
# ⚠️  Solo este archivo (.env.example) va en Git
# ============================================================


# ---------------------------
# ENTORNO DE LA APLICACIÓN
# ---------------------------

# "development" | "staging" | "production"
ENVIRONMENT=development

# Nivel de logs: "debug" | "info" | "warning" | "error"
LOG_LEVEL=debug

# Puerto del backend
PORT=8000

# Origen(es) permitidos por CORS (separados por coma)
# En desarrollo: el puerto de Vite
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# ---------------------------
# BASE DE DATOS
# ---------------------------

# SQLite para desarrollo (sin configuración extra):
DATABASE_URL=sqlite+aiosqlite:///./supplyai_dev.db

# PostgreSQL para producción (descomenta y ajusta):
# DATABASE_URL=postgresql+asyncpg://usuario:contraseña@localhost:5432/supplyai_db

# Número de conexiones en el pool (solo aplica a PostgreSQL)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10


# ---------------------------
# AUTENTICACIÓN JWT
# ---------------------------

# IMPORTANTE: Genera una clave segura con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Nunca uses el valor de ejemplo en producción
SECRET_KEY=62cdd809d2303680622238f461c2fc19f0ace714288e423f56c805e2617724c0

# Algoritmo JWT (HS256 es estándar, no cambiar sin justificación)
JWT_ALGORITHM=HS256

# Tiempo de expiración del access token (en minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Tiempo de expiración del refresh token (en días)
REFRESH_TOKEN_EXPIRE_DAYS=7


# ---------------------------
# GOOGLE MAPS API (Fase 3 — Rutas)
# ---------------------------
# Obtener en: https://console.cloud.google.com/
# Servicios requeridos: Routes API, Distance Matrix API

GOOGLE_MAPS_API_KEY=TU_API_KEY_DE_GOOGLE_MAPS_AQUI

# Región por defecto para cálculos de rutas
MAPS_DEFAULT_REGION=CO

# Límite de paradas por ruta (OR-Tools escala bien hasta ~20)
ROUTE_MAX_STOPS=20


# ---------------------------
# GROQ API — LLM para Chatbot (Fase 5)
# ---------------------------
# Obtener gratis en: https://console.groq.com/
# Modelo recomendado: llama-3.1-70b-versatile

GROQ_API_KEY=TU_API_KEY_DE_GROQ_AQUI
GROQ_MODEL=llama-3.1-70b-versatile

# Máximo de tokens en respuesta del chatbot
CHATBOT_MAX_TOKENS=1024

# Temperatura del LLM (0.0 = determinístico, 1.0 = creativo)
# Para consultas de inventario: mantener bajo (0.2-0.4)
CHATBOT_TEMPERATURE=0.3


# ---------------------------
# DANE — Datos IPC Colombia (Fase 2 — Forecasting)
# ---------------------------
# URL del CSV público de IPC mensual del DANE
# Actualizado mensualmente por el DANE
DANE_IPC_URL=https://www.dane.gov.co/files/operaciones/IPC/ipc_serie_historica.csv

# Cada cuántos días descargar datos frescos del DANE
DANE_REFRESH_DAYS=30

# Directorio donde guardar el CSV cacheado del DANE
DANE_CACHE_DIR=./data/dane_cache


# ---------------------------
# MODELOS ML
# ---------------------------
# Directorio donde se guardan los modelos entrenados (.pkl, .json)
ML_MODELS_DIR=./ml_models

# Cada cuántos días re-entrenar los modelos de forecasting
FORECAST_RETRAIN_DAYS=7

# Horizonte máximo de predicción en días
FORECAST_HORIZON_DAYS=30

# Umbral de alerta por defecto: días de stock restantes
DEFAULT_ALERT_THRESHOLD_DAYS=5


# ---------------------------
# ALMACENAMIENTO DE ARCHIVOS
# ---------------------------
# Directorio para archivos subidos por usuarios (CSV/Excel)
UPLOAD_DIR=./uploads

# Tamaño máximo de archivo subido (en MB)
MAX_UPLOAD_SIZE_MB=50

# Formatos permitidos para upload
ALLOWED_UPLOAD_FORMATS=csv,xlsx,xls


# ---------------------------
# WEBSOCKETS (Alertas en tiempo real)
# ---------------------------
# Tiempo de heartbeat en segundos para mantener conexión WebSocket viva
WS_HEARTBEAT_SECONDS=30
